# Public site URL, used for canonical tags, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.saildeck.com

# Where enquiry-form submissions are emailed. Requires RESEND_API_KEY.
ENQUIRY_TO_EMAIL=info@saildeck.com
RESEND_API_KEY=

# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Live Google reviews on the homepage. Without these the section falls back to
# the flagged placeholder cards in src/data/reviews.ts.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
