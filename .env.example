# Public site URL, used for canonical tags, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.saildeck.com

# Where enquiry-form submissions are emailed. Requires RESEND_API_KEY.
ENQUIRY_TO_EMAIL=info@saildeck.com
RESEND_API_KEY=

# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Live Google reviews on the homepage. Without these the section falls back to
# the flagged placeholder cards in src/data/reviews.ts.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Razorpay — powers the "Pay by card" option on /pay, and the booking
# system's deposit checkout. Use the rzp_test_... keys from the Razorpay
# dashboard while testing, and switch to the live rzp_live_... keys only once
# you're ready to take real payments. Put real values in .env.local
# (gitignored), never here or in any committed file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Booking system database (Turso/libSQL). Leave both empty locally — it falls
# back to a file at .data/booking.db, created automatically. REQUIRED on
# Vercel: create a free database at turso.tech or via Vercel → Storage → Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signs the admin-calendar login session cookie. Use a long random string —
# anyone who has this can forge an admin session. Changing it signs every
# admin out.
ADMIN_SESSION_SECRET=

# WhatsApp Cloud API — sends an automated booking alert to WHATSAPP_NOTIFY_TO
# whenever a customer completes checkout. This number does NOT need to be
# your WhatsApp Business app number; it only needs to be able to receive
# messages. The SENDING number is a separate one you set up with Meta:
# create a Meta Business app → add the WhatsApp product → get a phone
# number ID + a permanent access token → get a "Utility" category message
# template approved with placeholders for boat, date, slot, customer name/
# phone, add-ons and deposit amount. Until these are set, bookings still
# work — the notification just logs instead of sending.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_NOTIFY_TO=918424848489
